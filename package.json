{
  "name": "rallypal",
  "version": "1.0.0",
  "description": "RallyPal: score keeper for racket sports on Zepp OS",
  "main": "app.js",
  "private": true,
  "scripts": {
    "test": "esbuild .dev/test/run.js --bundle --platform=node --format=esm --outfile=.test.mjs --log-level=warning && node .test.mjs",
    "sim": "node .dev/tools/sim/run.mjs .dev/tools/sim/out && python3 .dev/tools/sim/render.py .dev/tools/sim/out"
  },
  "devDependencies": {
    "@zeppos/device-types": "^3.0.1",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.25"
  }
}
