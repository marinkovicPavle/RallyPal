{
  "configVersion": "v3",
  "app": {
    "appId": 1099457,
    "appName": "RallyPal proba",
    "appType": "app",
    "extType": "workout",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "pavle",
    "description": "Probni ekran za RallyPal: u kojim treninzima se nudi, tap na polovine, vibracije, puls i trajanje"
  },
  "permissions": ["data:os.device.info", "data:user.hd.workout", "data:user.hd.heart_rate", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6",
      "target": "3.6",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "common": {
      "module": {
        "data-widget": {
          "widgets": [
            {
              "path": "data-widget/index",
              "name": "RallyPal proba",
              "icon": "icon.png",
              "window": {
                "isPinned": 1
              },
              "runtime": {
                "ability": [
                  {
                    "type": 1,
                    "subType": []
                  }
                ]
              }
            }
          ]
        }
      },
      "platforms": [{ "st": "r", "dw": 480 }],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "RallyPal proba",
      "data-widget": { "widgets": [{ "name": "RallyPal proba" }] }
    },
    "sr-RS": {
      "appName": "RallyPal proba",
      "data-widget": { "widgets": [{ "name": "RallyPal proba" }] }
    }
  },
  "defaultLanguage": "en-US"
}
