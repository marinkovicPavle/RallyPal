{
  "configVersion": "v3",
  "app": {
    "appId": 1134434,
    "appName": "RallyPal",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "pavle",
    "description": "Score keeper for tennis, padel, pickleball, table tennis, squash and badminton"
  },
  "permissions": [
    "data:os.device.info",
    "data:user.hd.heart_rate",
    "data:user.info",
    "device:os.bg_service",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.6",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/match",
            "page/summary",
            "page/history",
            "page/settings",
            "page/unlock"
          ]
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "RallyPal",
              "runtime": {
                "type": "js"
              }
            }
          ]
        },
        "app-service": {
          "services": [
            "app-service/hr"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "RallyPal"
    },
    "sr-RS": {
      "appName": "RallyPal"
    },
    "es-ES": {
      "appName": "RallyPal"
    },
    "it-IT": {
      "appName": "RallyPal"
    },
    "de-DE": {
      "appName": "RallyPal"
    },
    "fr-FR": {
      "appName": "RallyPal"
    },
    "pt-BR": {
      "appName": "RallyPal"
    },
    "pt-PT": {
      "appName": "RallyPal"
    },
    "nl-NL": {
      "appName": "RallyPal"
    },
    "pl-PL": {
      "appName": "RallyPal"
    },
    "cs-CZ": {
      "appName": "RallyPal"
    },
    "uk-UA": {
      "appName": "RallyPal"
    },
    "ru-RU": {
      "appName": "RallyPal"
    },
    "sv-SE": {
      "appName": "RallyPal"
    },
    "nb-NO": {
      "appName": "RallyPal"
    },
    "da-DK": {
      "appName": "RallyPal"
    },
    "fi-FI": {
      "appName": "RallyPal"
    },
    "ja-JP": {
      "appName": "RallyPal"
    }
  },
  "defaultLanguage": "en-US"
}
